// LOCAL DEVELOPMENT SCHEMA — SQLite
// Used with --schema=prisma/schema.dev.prisma
// Production schema (postgresql) is prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatar       String?
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())

  todos        Todo[]
  projects     Project[]
  areas        Area[]
  habits       Habit[]
  activityLogs ActivityLog[]
  badges       Badge[]
  streaks      Streak[]
  apiKeys      ApiKey[]
  vaultItems   VaultItem[]
  waitingFor   WaitingFor[]
}

model Area {
  id          String   @id @default(cuid())
  userId      String
  name        String
  icon        String   @default("📁")
  color       String   @default("#6b7280")
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  projects Project[]
}

model Todo {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  priority    String    @default("medium")
  tags        String    @default("[]")
  dueDate     DateTime?
  isLifetime  Boolean   @default(false)
  progress    Int?
  progressMax Int?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Project {
  id                String   @id @default(cuid())
  userId            String
  areaId            String?
  title             String
  description       String?
  successDefinition String?
  firstStep         String?
  notes             String?
  status            String   @default("active")
  progressPct       Int      @default(0)
  color             String   @default("#8b5cf6")
  createdAt         DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area       Area?       @relation(fields: [areaId], references: [id])
  milestones Milestone[]
  subtasks   Subtask[]
  waitingFor WaitingFor[]
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  order       Int       @default(0)
  timeFrame   String?   // thisMonth, thisWeek, today, rightNow
  isFirstStep Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtasks  Subtask[]
  waitingFor WaitingFor[] @relation("MilestoneWaitingFor")
}

model Subtask {
  id          String    @id @default(cuid())
  projectId   String
  milestoneId String?
  title       String
  order       Int       @default(0)
  timeFrame   String?   // thisMonth, thisWeek, today, rightNow
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  waitingFor WaitingFor[] @relation("SubtaskWaitingFor")
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  title       String
  type        String   @default("good")
  icon        String   @default("⭐")
  frequency   String   @default("daily")
  unit        String?
  targetValue Float?
  createdAt   DateTime @default(now())

  user User      @relation(fields: [userId], references: [id])
  logs HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  completed Boolean  @default(true)
  value     Float?
  notes     String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  content   String
  category  String   @default("general")
  source    String   @default("manual")
  tags      String   @default("[]")
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Badge {
  id         String   @id @default(cuid())
  userId     String
  badgeType  String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, badgeType])
}

model Streak {
  id           String    @id @default(cuid())
  userId       String
  type         String
  currentCount Int       @default(0)
  bestCount    Int       @default(0)
  lastDate     DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  keyHash   String
  label     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model VaultItem {
  id        String   @id @default(cuid())
  userId    String
  category  String
  title     String
  data      String   @default("{}")
  tags      String   @default("[]")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id])
  reminders VaultReminder[]
}

model VaultReminder {
  id          String   @id @default(cuid())
  vaultItemId String
  remindAt    DateTime
  repeat      String   @default("none")
  message     String?
  isActive    Boolean  @default(true)

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
}

model WaitingFor {
  id                      String   @id @default(cuid())
  projectId               String
  referencedMilestoneId   String?
  referencedSubtaskId     String?
  taggedUserId            String?
  note                    String?
  createdAt               DateTime @default(now())

  project             Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referencedMilestone Milestone? @relation("MilestoneWaitingFor", fields: [referencedMilestoneId], references: [id], onDelete: SetNull)
  referencedSubtask   Subtask?   @relation("SubtaskWaitingFor", fields: [referencedSubtaskId], references: [id], onDelete: SetNull)
  taggedUser          User?      @relation(fields: [taggedUserId], references: [id], onDelete: SetNull)
}
